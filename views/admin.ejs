<%- include("partials/header", { title }) %>
<section class="page-hero compact-hero"><div class="container"><p class="eyebrow eyebrow-light">BUSINESS CONTROL CENTRE</p><h1>Admin <em>dashboard.</em></h1><p>Review customer requests, manage service listings and update order progress.</p></div></section>
<section class="section section-warm"><div class="container">
<div class="notice"><strong>Admin notifications</strong><p>New contact enquiries, food orders and event quotation requests trigger email and WhatsApp alerts. Accepted means the provider accepted the message; delivery is not confirmed.</p><% if (typeof adminNotificationConfig !== 'undefined') { %><p>Email: <%= adminNotificationConfig.email ? 'Configured' : 'Setup required' %> ? WhatsApp: <%= adminNotificationConfig.whatsapp ? 'Configured' : 'Setup required' %>.</p><% } %></div>
<div class="stats-grid"><div class="stat-card"><span>Total bookings</span><strong><%= stats.bookingCount %></strong></div><div class="stat-card"><span>Total orders</span><strong><%= stats.orderCount %></strong></div><div class="stat-card"><span>Customers</span><strong><%= customers %></strong></div><div class="stat-card"><span>Marked paid</span><strong><%= currency(stats.paidTotal) %></strong></div></div>
<div class="dashboard-heading top-gap"><div><p class="eyebrow">CATALOGUE</p><h2>Manage services</h2></div></div>
<div class="table-wrap"><table><thead><tr><th>Service</th><th>Category</th><th>Price</th><th>Availability</th><th>Action</th></tr></thead><tbody><% services.forEach(s => { %><tr><td><strong><%= s.name %></strong><small><%= s.unit %></small></td><td><%= s.category %></td><td><%= currency(s.price) %></td><td><span class="status"><%= s.active ? "Active" : "Hidden" %></span></td><td><form method="post" action="/admin/services/<%= s._id %>/toggle"><button class="small-btn" type="submit"><%= s.active ? "Hide" : "Activate" %></button></form></td></tr><% }) %></tbody></table></div>
<details class="admin-add"><summary>+ Add a service or menu item</summary><form class="form-card admin-form" method="post" action="/admin/services"><div class="form-two"><label>Service name<input name="name" required maxlength="150"></label><label>Category<select name="category" required><option>Food</option><option>Event Catering</option><option>Hospitality</option><option>Equipment Hire</option></select></label></div><label>Description<textarea name="description" rows="2" required maxlength="1000"></textarea></label><div class="form-two"><label>Price (KES)<input name="price" type="number" min="0" step="1" required></label><label>Price unit<input name="unit" maxlength="60" placeholder="per guest"></label></div><label>Image URL (optional)<input name="image" type="url" placeholder="https://..."></label><button class="btn btn-dark" type="submit">Add service</button></form></details>
<div class="dashboard-heading top-gap"><div><p class="eyebrow">CUSTOMER REQUESTS</p><h2>Event bookings</h2></div></div>
<% if (!bookings.length) { %><div class="empty-state">No bookings have been submitted yet.</div><% } %>
<div class="admin-records"><% bookings.forEach(b => { %><article class="record-card"><div class="record-top"><div><span class="status"><%= b.status %></span><h3><%= b.type %> · <%= b.guestCount %> guests</h3><p><%= b.requesterName || (b.customer ? b.customer.name : "Customer") %> · <%= b.requesterEmail || (b.customer ? b.customer.email : "") %></p></div><div class="record-date"><%= new Date(b.eventDate).toLocaleDateString("en-KE") %><small><%= b.venue %></small></div></div><%- include("partials/admin-notifications", { record: b, kind: "booking" }) %><p class="record-notes">Approver notification: <%= b.approverNotificationStatus || "Not sent" %>. <% if (b.approverNotificationStatus === "Failed") { %>Notification email failed; this booking is saved here for review.<% } %></p><% if (b.menuNeeds) { %><p class="record-notes"><strong>Needs:</strong> <%= b.menuNeeds %></p><% } %><form class="admin-inline-form" method="post" action="/admin/bookings/<%= b._id %>"><label>Status<select name="status"><% bookingStatuses.forEach(st => { %><option <%= b.status === st ? "selected" : "" %>><%= st %></option><% }) %></select></label><label>Quote (KES)<input type="number" name="quoteAmount" min="0" step="1" value="<%= b.quoteAmount == null ? '' : b.quoteAmount %>" placeholder="Amount"></label><label>Proposed new date<input type="date" name="proposedDate" value="<%= b.proposedDate ? new Date(b.proposedDate).toISOString().slice(0,10) : '' %>"></label><label class="notes-label">Approver comments (visible to requester)<textarea name="approverComment" rows="3" maxlength="3000" placeholder="Approval details or reason for rescheduling"><%= b.approverComment || '' %></textarea></label><label class="notes-label">Internal admin notes<input name="adminNotes" value="<%= b.adminNotes || '' %>" maxlength="3000" placeholder="Internal notes"></label><div class="booking-email-actions"><p>Send to: <strong><%= b.requesterEmail || (b.customer && b.customer.email) || 'No email available' %></strong></p><p>Latest update email: <%= b.emailStatus || 'Not sent' %><% if (b.emailedAt) { %> on <%= new Date(b.emailedAt).toLocaleString("en-KE", { timeZone: "Africa/Nairobi" }) %><% } %></p><% if (!emailConfigured) { %><p>Email sending is not configured. Add SMTP settings to enable it.</p><% } %><button class="small-btn" type="submit">Save without emailing</button> <button class="small-btn" type="submit" name="sendEmail" value="on" <%= emailConfigured ? '' : 'disabled' %>>Save and email requester</button></div></form></article><% }) %></div>
<div class="dashboard-heading top-gap"><div><p class="eyebrow">FULFILMENT</p><h2>Food orders</h2></div></div>
<% if (!orders.length) { %><div class="empty-state">No food orders have been submitted yet.</div><% } %>
<div class="admin-records"><% orders.forEach(o => { %><article class="record-card"><div class="record-top"><div><span class="status"><%= o.status %></span><h3>Order #<%= o._id.toString().slice(-6).toUpperCase() %> · <%= currency(o.total) %></h3><p><%= o.requesterName || (o.customer ? o.customer.name : "Customer") %> · <%= o.requesterEmail || (o.customer ? o.customer.email : "") %></p><p>Phone: <%= o.phone || "Not provided" %></p><p><%= o.items.map(i => `${i.name} × ${i.quantity}`).join(", ") %></p></div><div class="record-date"><%= o.paymentMethod %><small><%= o.deliveryAddress %></small></div></div><%- include("partials/admin-notifications", { record: o, kind: "order" }) %><form class="admin-inline-form" method="post" action="/admin/orders/<%= o._id %>"><label>Order status<select name="status"><% ["Received","Confirmed","Preparing","Ready for dispatch","Out for delivery","Delivered","Cancelled"].forEach(st => { %><option <%= o.status === st ? "selected" : "" %>><%= st %></option><% }) %></select></label><label>Food / services quote (KES)<input type="number" name="foodTotal" min="1" step="0.01" value="<%= o.quoted ? (o.total - (o.deliveryFee || 0)).toFixed(2) : '' %>" <%= o.paymentReference || o.paymentStatus === 'Paid' ? 'readonly' : '' %>></label><label>Delivery fee (KES)<input type="number" name="deliveryFee" min="0" step="0.01" value="<%= o.deliveryFee || 0 %>" <%= o.paymentReference || o.paymentStatus === 'Paid' ? 'readonly' : '' %>></label><label>Driver / delivery contact<input name="deliveryContact" maxlength="200" value="<%= o.deliveryContact || '' %>"></label><label>Delivery update<input name="deliveryNotes" maxlength="1000" value="<%= o.deliveryNotes || '' %>"></label><div class="booking-email-actions"><p>Payment: <strong><%= o.paymentStatus %></strong> &middot; Total: <%= currency(o.total) %>. Payment must be verified before preparation and dispatch.</p><% if(o.accessToken) { %><a class="text-link" href="/requests/<%= o.accessToken %>" target="_blank" rel="noopener">View private order page</a><% } %><p>Quotes are locked when checkout begins.</p><button class="small-btn" type="submit">Save</button> <button class="small-btn" type="submit" name="emailOrder" value="on">Save and email quotation / update</button></div></form></article><% }) %></div>
<div class="dashboard-heading top-gap"><div><p class="eyebrow">CONTACT REQUESTS</p><h2>Client enquiries</h2></div></div>
<% const contactInquiries = typeof inquiries === 'undefined' ? [] : inquiries; %>
<% if (!contactInquiries.length) { %><div class="empty-state">No contact enquiries have been submitted yet.</div><% } %>
<div class="admin-records"><% contactInquiries.forEach(inquiry => { %>
  <article class="record-card">
    <div class="record-top"><div><h3><%= inquiry.subject || 'General enquiry' %></h3><p><%= inquiry.requesterName %> &middot; <%= inquiry.requesterEmail %></p></div><div class="record-date"><%= new Date(inquiry.createdAt).toLocaleString('en-KE', { timeZone: 'Africa/Nairobi' }) %></div></div>
    <p class="record-notes" style="white-space: pre-wrap"><%= inquiry.message %></p>
    <%- include('partials/admin-notifications', { record: inquiry, kind: 'inquiry' }) %>
    <a class="text-link" href="mailto:<%= inquiry.requesterEmail %>">Reply by email</a>
  </article>
<% }) %></div>
<div class="notice top-gap"><strong>Payment safety</strong><p>Orders are marked paid only after server verification with Paystack. Configure and test your merchant account before accepting live payments. Preparation and dispatch require verified payment.</p></div>
</div></section>
<%- include("partials/footer") %>
