<%- include("partials/header", { title }) %>
<section class="auth-section">
  <div class="auth-image"><div>
    <p class="eyebrow eyebrow-light">A WARM WELCOME AWAITS</p>
    <h2>Good food.<br>Great company.</h2>
    <p><%= audience === "admin" ? "Sign in to review bookings, manage food orders and update services." : "Plan an event, request catering or follow your orders." %></p>
  </div></div>
  <div class="auth-panel"><div class="auth-form-wrap">
    <p class="eyebrow"><%= mode === "register" ? "JOIN NANNY EVENTS & CATERERS" : audience === "admin" ? "ADMINISTRATOR ACCESS" : "WELCOME BACK" %></p>
    <h1><%= mode === "register" ? "Create your account." : audience === "admin" ? "Admin sign in." : "Sign in to continue." %></h1>
    <p class="muted"><%= mode === "register" ? "Keep your event requests and orders together." : audience === "admin" ? "Access the dashboard to check and manage customer orders." : "Your bookings and food orders are waiting." %></p>
    <form id="auth-sign-in" class="auth-form" method="post" action="<%= mode === 'register' ? '/register' : audience === 'admin' ? '/admin/login' : '/login' %>">
      <% if (mode === "register") { %>
        <div class="auth-field">
          <label for="auth-name">Full name</label>
          <input id="auth-name" name="name" required maxlength="100" autocomplete="name">
        </div>
        <div class="auth-field">
          <label for="auth-phone">Phone number <span class="optional">(optional)</span></label>
          <input id="auth-phone" type="tel" name="phone" maxlength="30" autocomplete="tel" placeholder="+254 7XX XXX XXX">
        </div>
      <% } %>
      <div class="auth-field">
        <label for="auth-email">Email address</label>
        <input id="auth-email" type="email" name="email" required maxlength="200" autocomplete="email">
      </div>
      <div class="auth-field">
        <label for="auth-password">Password</label>
        <input id="auth-password" type="password" name="password" required minlength="<%= mode === 'register' ? 10 : 1 %>" autocomplete="<%= mode === 'register' ? 'new-password' : 'current-password' %>" <% if (mode === "register") { %>aria-describedby="password-hint"<% } %>>
        <% if (mode === "register") { %><p id="password-hint" class="auth-hint">Use at least 10 characters.</p><% } %>
      </div>
      <button class="btn btn-dark btn-full" type="submit"><%= mode === "register" ? "Create account" : "Sign in" %> <span aria-hidden="true">&#8599;</span></button>
    </form>
    <p class="auth-switch"><%= mode === "register" ? "Already have an account?" : "New to Nanny Events & Caterers?" %> <a href="<%= mode === 'register' ? '/login' : '/register' %>"><%= mode === "register" ? "Sign in" : "Create an account" %></a></p>
    <% if (mode === "login") { %>
      <div class="auth-options" aria-label="More ways to continue">
        <% if (audience === "admin") { %>
          <div class="auth-option"><span>FOR THE TEAM</span><strong>Admin sign in</strong><small>Check and manage bookings, orders and services.</small></div>
          <a class="auth-option" href="/login"><span>FOR CUSTOMERS</span><strong>Guest account sign in</strong><small>Review your bookings and food orders.</small></a>
        <% } else { %>
          <a class="auth-option" href="/admin/login"><span>FOR THE TEAM</span><strong>Admin sign in</strong><small>Check and manage bookings, orders and services.</small></a>
          <div class="auth-option"><span>BOOKING WITHOUT AN ACCOUNT</span><strong>Continue as a guest</strong><small>No account needed to book catering or request food.</small><span class="auth-option-links"><a href="/book">Book an event</a><a href="/services">Browse food & services</a></span></div>
        <% } %>
      </div>
    <% } %>
    <p class="form-note">Use a unique password. Do not share your account details.</p>
  </div></div>
</section>
<%- include("partials/footer") %>
