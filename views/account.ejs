<%- include("partials/header", { title }) %>
<section class="page-hero compact-hero"><div class="container"><p class="eyebrow eyebrow-light">YOUR NANNY ACCOUNT</p><h1>Welcome, <em><%= currentUser.name.split(" ")[0] %>.</em></h1><p>Review your event requests and food orders in one place.</p></div></section>
<section class="section section-warm"><div class="container"><div class="account-actions"><a class="btn btn-dark" href="/book">+ Request event catering</a><a class="btn btn-outline-dark" href="/services">Browse food & services</a></div>
<div class="dashboard-heading"><div><p class="eyebrow">EVENTS</p><h2>Your bookings</h2></div><span class="count-pill"><%= bookings.length %> requests</span></div>
<% if (!bookings.length) { %><div class="empty-state"><h3>No event requests yet</h3><p>Tell us about your next event to get started.</p><a class="text-link" href="/book">Plan an event ↗</a></div><% } else { %><div class="table-wrap"><table><thead><tr><th>Event</th><th>Date</th><th>Guests</th><th>Status</th><th>Quote</th><th>Approver comments</th></tr></thead><tbody><% bookings.forEach(b => { %><tr><td><strong><%= b.type %></strong><small><%= b.venue %></small></td><td><%= new Date(b.eventDate).toLocaleDateString("en-KE") %></td><td><%= b.guestCount %></td><td><span class="status"><%= b.status %></span></td><td><%= b.quoteAmount != null ? currency(b.quoteAmount) : "Pending" %></td><td class="booking-feedback"><p><%= b.approverComment || "Awaiting review from our team." %></p><% if (b.proposedDate) { %><small><strong>Proposed date: <%= new Date(b.proposedDate).toLocaleDateString("en-KE", { timeZone: "Africa/Nairobi" }) %></strong>Please contact us to confirm whether this date works for you.</small><% } %><% if (b.reviewedAt) { %><small>Reviewed <%= new Date(b.reviewedAt).toLocaleString("en-KE", { timeZone: "Africa/Nairobi" }) %></small><% } %><% if (b.requesterEmail) { %><small>Updates to: <%= b.requesterEmail %></small><% } %></td></tr><% }) %></tbody></table></div><% } %>
<div class="dashboard-heading top-gap"><div><p class="eyebrow">FOOD & DELIVERY</p><h2>Your orders</h2></div><span class="count-pill"><%= orders.length %> orders</span></div>
<% if (!orders.length) { %><div class="empty-state"><h3>No food orders yet</h3><p>Explore our menu for office lunches, snacks and event platters.</p><a class="text-link" href="/services">Browse the menu ↗</a></div><% } else { %><div class="table-wrap"><table><thead><tr><th>Order</th><th>Delivery</th><th>Total</th><th>Payment</th><th>Status</th></tr></thead><tbody><% orders.forEach(o => { %><tr><td><strong>#<%= o._id.toString().slice(-6).toUpperCase() %></strong><small><%= o.items.map(i => `${i.name} × ${i.quantity}`).join(", ") %></small></td><td><%= o.deliveryDate ? new Date(o.deliveryDate).toLocaleString("en-KE") : "To be confirmed" %><small><%= o.deliveryAddress %></small></td><td><%= currency(o.total) %></td><td><%= o.paymentMethod %><small><%= o.paymentStatus %></small></td><td><span class="status"><%= o.status %></span></td></tr><% }) %></tbody></table></div><% } %>
</div></section>
<%- include("partials/footer") %>