<%- include("partials/header", { title }) %>
<section class="section section-warm"><div class="container booking-layout">
  <div class="booking-intro"><p class="eyebrow">YOUR FOOD &amp; CATERING REQUEST</p><h1>Order #<%= order._id.toString().slice(-6).toUpperCase() %></h1><p>Keep this private link to check your quotation, payment and delivery. No account needed.</p><span class="status"><%= order.status %></span><ul class="check-list"><% order.items.forEach(item => { %><li><%= item.name %> &times; <%= item.quantity %></li><% }) %></ul></div>
  <div class="form-card"><h2>Payment &amp; delivery</h2><p><strong>Customer:</strong> <%= order.requesterName %></p><p><strong>Email:</strong> <%= order.requesterEmail %></p><p><strong>Delivery:</strong> <%= order.deliveryAddress %></p><p><strong>Requested time:</strong> <%= order.deliveryDate ? new Date(order.deliveryDate).toLocaleString("en-KE", {timeZone:"Africa/Nairobi"}) : "To be agreed" %></p><p><strong>Delivery contact:</strong> <%= order.deliveryContact || "To be assigned" %></p><% if(order.deliveryNotes) { %><p><%= order.deliveryNotes %></p><% } %>
  <% if(order.quoted) { %><div class="total-row"><span>Food / services</span><strong><%= currency(order.total - order.deliveryFee) %></strong></div><div class="total-row"><span>Delivery fee</span><strong><%= currency(order.deliveryFee) %></strong></div><div class="total-row"><span>Total to pay</span><strong><%= currency(order.total) %></strong></div><% } else { %><p>Our team will confirm availability and send the final quotation, including delivery, to your email.</p><% } %>
  <p><strong>Payment:</strong> <%= order.paymentStatus %> &middot; <%= order.paymentMethod %></p>
  <% if(order.quoted && order.paymentStatus !== "Paid" && order.status !== "Cancelled") { %><% if(paymentsConfigured) { %><form action="/requests/<%= order.accessToken %>/pay" method="post"><button class="btn btn-dark btn-full">Pay securely with <%= order.paymentMethod === "Card" ? "credit / debit card" : "M-PESA" %></button></form><% } else { %><div class="notice"><strong>Online payment is awaiting setup</strong><p>Please contact our team. Your order is saved and will remain pending payment.</p></div><% } %><% } %>
  <% if(order.paymentReference && order.paymentStatus !== "Paid") { %><p><a class="text-link" href="/requests/<%= order.accessToken %>/verify">Already paid? Check payment status</a></p><% } %>
  <p class="form-note">Payment is required before preparation and dispatch. Card details and M-PESA authorisation are handled by the payment provider.</p></div>
</div></section>
<%- include("partials/footer") %>
