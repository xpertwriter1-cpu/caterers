<%- include("partials/header", { title }) %>
<section class="section section-warm"><div class="container order-layout"><div class="order-photo"><img src="<%= service.image || '/images/kenyan-food-spread.jpg' %>" alt="<%= service.name %>"></div><div class="order-details"><p class="eyebrow"><%= service.category %></p><h1><%= service.name %></h1><p><%= service.description %></p><div class="order-price"><%= service.quoteOnly || !service.price ? "Request a quote" : currency(service.price) %> <small><%= service.quoteOnly || !service.price ? "Menu and price confirmed by the team" : service.unit %></small></div><div class="notice"><strong>Before you order</strong><p>Request food or catering online without creating an account. Our team confirms availability, the food price and delivery fee, then sends you a payment link. Payment is required before preparation and delivery.</p></div>
<form class="form-card compact-form" method="post" action="/order/<%= service._id %>"><label>Your name<input name="requesterName" required maxlength="100" autocomplete="name" value="<%= currentUser ? currentUser.name : '' %>"></label><label>Email for quotation and order updates<input type="email" name="requesterEmail" required maxlength="254" autocomplete="email" value="<%= currentUser ? currentUser.email || '' : '' %>"></label><label>Delivery phone number<input name="phone" type="tel" required maxlength="30" autocomplete="tel" placeholder="07xx xxx xxx"></label><label>Quantity / number of guests<input id="quantity" type="number" name="quantity" min="1" max="5000" value="1" required></label><div class="total-row"><span>Price estimate</span><strong id="estimated-total" data-price="<%= service.price %>"><%= service.quoteOnly || !service.price ? "To be confirmed" : currency(service.price) %></strong></div><label>Delivery address / venue<input name="deliveryAddress" required maxlength="500" placeholder="Town, building, street or venue"></label><label>Preferred delivery date and time<input type="datetime-local" name="deliveryDate"></label><label>Payment preference<select name="paymentMethod"><option value="M-PESA">M-PESA</option><option value="Card">Credit / debit card</option></select></label><label>Notes<textarea name="notes" rows="2" maxlength="2000" placeholder="Dietary needs or delivery instructions"></textarea></label><button class="btn btn-dark btn-full" type="submit">Request food / catering ↗</button></form></div></div></section>
<%- include("partials/footer") %>