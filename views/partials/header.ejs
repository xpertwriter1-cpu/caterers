<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Nanny Events & Caterers — Nairobi event catering, traditional Kenyan menus, weddings, dowry ceremonies, corporate functions and food delivery.">
  <title><%= title %> | Nanny Events & Caterers</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
<header class="site-header">
  <div class="container nav-wrap">
    <a class="brand" href="/" aria-label="Nanny Events & Caterers home"><img class="brand-logo" src="/images/nanny-events-logo.png" alt="Nanny Events & Caterers — Food with passion"></a>
    <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">☰</button>
    <nav class="nav-links">
      <a href="/">Home</a><a href="/services">Services & Menu</a><a href="/book">Book an Event</a><a href="/about">About</a><a href="/contact">Contact</a><a class="nav-whatsapp" href="https://wa.me/254723548397?text=Hello%20Nanny%20Events%20%26%20Caterers%2C%20I%27d%20like%20to%20make%20an%20enquiry." target="_blank" rel="noopener">WhatsApp</a>
      <% if (currentUser) { %>
        <a href="<%= currentUser.role === 'admin' ? '/admin' : '/account' %>"><%= currentUser.role === 'admin' ? 'Admin' : 'My Account' %></a>
        <form class="logout-form" action="/logout" method="post"><button class="nav-logout" type="submit">Sign out</button></form>
      <% } else { %><a href="/login">Sign in</a><a class="nav-cta" href="/register">Get Started</a><% } %>
    </nav>
  </div>
</header>
<main>
  <div class="container flash-area">
    <% if (flash) { %><div class="alert alert-<%= flash.type %>"><%= flash.message %></div><% } %>
  </div>