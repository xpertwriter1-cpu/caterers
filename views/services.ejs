<%- include("partials/header", { title }) %>
<section class="page-hero"><div class="container"><p class="eyebrow eyebrow-light">OUR SERVICES</p><h1>Catering for the moments<br><em>that matter.</em></h1><p>Request food delivery, traditional Kenyan menus, event catering and hospitality support online. No account needed. All prices and availability are confirmed individually before you commit.</p></div></section>
<section class="section section-warm"><div class="container">
  <div class="filter-row"><span class="eyebrow">EXPLORE THE MENU</span><div class="filter-links"><a class="<%= !selectedCategory ? 'active' : '' %>" href="/services">All services</a><% ["Food","Event Catering","Hospitality","Equipment Hire"].forEach(c => { %><a class="<%= selectedCategory === c ? 'active' : '' %>" href="/services?category=<%= encodeURIComponent(c) %>"><%= c %></a><% }) %></div></div>
  <% if (!services.length) { %><div class="empty-state"><h2>No services in this category yet</h2><p>Please check another category or contact us for a custom request.</p></div><% } %>
  <div class="service-grid">
  <% services.forEach((service, index) => { %><article class="service-card"><a class="service-image" href="/order/<%= service._id %>"><img src="<%= service.image || '/images/kenyan-food-spread.jpg' %>" alt="<%= service.name %>" loading="lazy"><span class="image-number"><%= String(index+1).padStart(2,"0") %></span></a><div class="service-card-body"><p class="card-category"><%= service.category %></p><h3><%= service.name %></h3><p><%= service.description %></p><div class="card-bottom"><strong><%= service.quoteOnly || !service.price ? "Request a quote" : currency(service.price) %> <small><%= service.quoteOnly || !service.price ? "· availability confirmed" : service.unit %></small></strong><a href="/order/<%= service._id %>">Order / enquire ↗</a></div></div></article><% }) %>
  </div>
  <div class="custom-request"><div><h2>Have a special menu in mind?</h2><p>Ask about kienyeji chicken, pilau, chapati, mukimo, nyama choma, custom menus and large guest counts.</p></div><a class="btn btn-dark" href="/book">Tell us what you need ↗</a></div>
</div></section>
<%- include("partials/footer") %>