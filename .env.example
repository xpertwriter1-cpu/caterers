PORT=3001
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret
# Prisma datasource: keep the same MongoDB Atlas database name when upgrading.
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/nanny_events_caterers?retryWrites=true&w=majority
ADMIN_NAME=Nanny Website Administrator
ADMIN_EMAIL=replace-with-your-admin-email@example.com
ADMIN_PASSWORD=ReplaceWithALongUniquePassword123!
# Payment integrations are intentionally not activated until provider credentials are added.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
CARD_PAYMENT_PROVIDER=manual
CARD_PAYMENT_SECRET_KEY=
# Booking update emails. For Gmail use an App Password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REPLY_TO=
# Inbox that receives new bookings (defaults to ADMIN_EMAIL).
BOOKING_APPROVER_EMAIL=
# Admin alerts for contact enquiries, new orders and event quotation requests (email defaults to BOOKING_APPROVER_EMAIL / ADMIN_EMAIL).
ADMIN_NOTIFICATION_EMAIL=
# WhatsApp via Twilio: use international format, including +, without the whatsapp: prefix.
ADMIN_WHATSAPP_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Approved template with four variables: request type, reference, summary, admin dashboard URL.
TWILIO_WHATSAPP_CONTENT_SID=
# Paystack Kenya checkout: enable card and mobile money in your merchant account.
PAYSTACK_SECRET_KEY=
PUBLIC_BASE_URL=http://localhost:3001
